<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Show photos from a day in your scrapbook when you enable Photos.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Show calendar events on their matching journal day when you enable Calendar.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use the microphone only when you choose Dictate text, Record audio or Record video.</string>
	<key>NSCameraUsageDescription</key>
	<string>Record a video memory only when you tap Record video.</string>
	<key>CFBundleDisplayName</key>
	<string>Memory Catcher 3</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Memory Catcher 3</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribe speech when you choose Dictate text or include an audio or video recording in summaries. Recognition runs on this device.</string>
</dict>
</plist>
